<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">

  <?ifdef JpIsSystemWide ?>
    <?define JpInstallScope="perMachine"?>
  <?else?>
    <?define JpInstallScope="perUser"?>
  <?endif?>

  <?define JpProductLanguage=1033 ?>
  <?define JpInstallerVersion=200 ?>
  <?define JpCompressedMsi=yes ?>

  <?include $(var.JpConfigDir)/overrides.wxi ?>

  <?ifdef JpAllowUpgrades ?>
    <?define JpUpgradeVersionOnlyDetectUpgrade="no"?>
  <?else?>
    <?define JpUpgradeVersionOnlyDetectUpgrade="yes"?>
  <?endif?>
  <?ifdef JpAllowDowngrades ?>
    <?define JpUpgradeVersionOnlyDetectDowngrade="no"?>
  <?else?>
    <?define JpUpgradeVersionOnlyDetectDowngrade="yes"?>
  <?endif?>

  <Product
    Id="$(var.JpProductCode)"
    Name="$(var.JpAppName)"
    Language="$(var.JpProductLanguage)"
    Version="$(var.JpAppVersion)"
    Manufacturer="$(var.JpAppVendor)"
    UpgradeCode="$(var.JpProductUpgradeCode)">

    <Package
      Description="$(var.JpAppDescription)"
      Manufacturer="$(var.JpAppVendor)"
      InstallerVersion="$(var.JpInstallerVersion)"
      Compressed="$(var.JpCompressedMsi)"
      InstallScope="$(var.JpInstallScope)" Platform="x64"
    />

    <Media Id="1" Cabinet="Data.cab" EmbedCab="yes" />

    <Upgrade Id="$(var.JpProductUpgradeCode)">
      <UpgradeVersion
        OnlyDetect="$(var.JpUpgradeVersionOnlyDetectUpgrade)"
        Property="JP_UPGRADABLE_FOUND"
        Maximum="$(var.JpAppVersion)"
        MigrateFeatures="yes"
        IncludeMaximum="$(var.JpUpgradeVersionOnlyDetectUpgrade)" />
      <UpgradeVersion
        OnlyDetect="$(var.JpUpgradeVersionOnlyDetectDowngrade)"
        Property="JP_DOWNGRADABLE_FOUND"
        Minimum="$(var.JpAppVersion)"
        MigrateFeatures="yes"
        IncludeMinimum="$(var.JpUpgradeVersionOnlyDetectDowngrade)" />
    </Upgrade>

    <?ifndef JpAllowUpgrades ?>
    <CustomAction Id="JpDisallowUpgrade" Error="!(loc.DisallowUpgradeErrorMessage)" />
    <?endif?>
    <?ifndef JpAllowDowngrades ?>
    <CustomAction Id="JpDisallowDowngrade" Error="!(loc.DowngradeErrorMessage)" />
    <?endif?>

    <!-- Standard required root -->
    <Directory Id="TARGETDIR" Name="SourceDir"/>

    <Feature Id="DefaultFeature" Title="!(loc.MainFeatureTitle)" Level="1">
      <ComponentGroupRef Id="Shortcuts"/>
      <ComponentGroupRef Id="Files"/>
      <ComponentGroupRef Id="FileAssociations"/>
    </Feature>

    <CustomAction Id="JpSetARPINSTALLLOCATION" Property="ARPINSTALLLOCATION" Value="[INSTALLDIR]" />
    <CustomAction Id="JpSetARPCOMMENTS" Property="ARPCOMMENTS" Value="$(var.JpAppDescription)" />
    <CustomAction Id="JpSetARPCONTACT" Property="ARPCONTACT" Value="$(var.JpAppVendor)" />
    <CustomAction Id="JpSetARPSIZE" Property="ARPSIZE" Value="$(var.JpAppSizeKb)" />

    <?ifdef JpHelpURL ?>
      <CustomAction Id="JpSetARPHELPLINK" Property="ARPHELPLINK" Value="$(var.JpHelpURL)" />
    <?endif?>

    <?ifdef JpAboutURL ?>
      <CustomAction Id="JpSetARPURLINFOABOUT" Property="ARPURLINFOABOUT" Value="$(var.JpAboutURL)" />
    <?endif?>

    <?ifdef JpUpdateURL ?>
      <CustomAction Id="JpSetARPURLUPDATEINFO" Property="ARPURLUPDATEINFO" Value="$(var.JpUpdateURL)" />
    <?endif?>

    <?ifdef JpIcon ?>
    <Property Id="ARPPRODUCTICON" Value="JpARPPRODUCTICON"/>
    <Icon Id="JpARPPRODUCTICON" SourceFile="$(var.JpIcon)"/>
    <?endif?>

    <!-- Wizard con marca "amover" (Bauhaus cromado), en vez del JpUI vacío
         que genera jpackage por defecto. banner.png/lateral.png no viajan al
         directorio de config que arma jpackage (solo copia los .wxs/.wxi/.wxl
         que reconoce por nombre), así que se referencian por ruta absoluta;
         @@WIX_ASSETS_DIR@@ lo reemplaza la tarea packageMsiBranded en tiempo
         de build con la ruta real de app/packaging/wix. -->
    <Binary Id="LateralImageBmp" SourceFile="@@WIX_ASSETS_DIR@@\lateral.png" />
    <Binary Id="BannerImageBmp" SourceFile="@@WIX_ASSETS_DIR@@\banner.png" />

    <UI Id="AmoverInstallerUI">
      <Property Id="DefaultUIFont" Value="AmoverBody" />
      <TextStyle Id="AmoverTitle" FaceName="Tahoma" Size="12" Bold="yes" />
      <TextStyle Id="AmoverBody" FaceName="Tahoma" Size="9" />

      <!-- Bienvenida: columna izquierda a toda altura con el Punkt dorado
           (lateral.png), texto + Next/Cancel a la derecha. -->
      <Dialog Id="WelcomeDlg" Width="370" Height="260" Title="Instalación de amover">
        <Control Id="WelcomeBitmap" Type="Bitmap" X="0" Y="0" Width="130" Height="260" TabSkip="no" Text="LateralImageBmp" />
        <Control Id="WelcomeTitle" Type="Text" X="140" Y="20" Width="220" Height="40" Transparent="yes" NoPrefix="yes">
          <Text>{\AmoverTitle}Bienvenido al instalador de amover</Text>
        </Control>
        <Control Id="WelcomeDescription" Type="Text" X="140" Y="65" Width="220" Height="140" Transparent="yes">
          <Text>Este asistente va a instalar amover en tu computadora. Se recomienda cerrar el resto de las aplicaciones antes de continuar. Presioná Siguiente para continuar.</Text>
        </Control>
        <Control Id="WelcomeNext" Type="PushButton" X="236" Y="230" Width="56" Height="17" Default="yes" Text="Siguiente &gt;">
          <Publish Event="NewDialog" Value="InstallDirDlg">1</Publish>
        </Control>
        <Control Id="WelcomeCancel" Type="PushButton" X="304" Y="230" Width="56" Height="17" Cancel="yes" Text="Cancelar">
          <Publish Event="EndDialog" Value="Exit">1</Publish>
        </Control>
      </Dialog>

      <!-- Elegir carpeta: logo chico arriba-izquierda (banner.png), título y
           descripción al lado, selector de carpeta debajo. -->
      <Dialog Id="InstallDirDlg" Width="370" Height="260" Title="Instalación de amover">
        <Control Id="InstallDirBitmap" Type="Bitmap" X="18" Y="18" Width="44" Height="46" TabSkip="no" Text="BannerImageBmp" />
        <Control Id="InstallDirTitle" Type="Text" X="72" Y="20" Width="280" Height="20" Transparent="yes" NoPrefix="yes">
          <Text>{\AmoverTitle}Elegir lugar de instalación</Text>
        </Control>
        <Control Id="InstallDirDescription" Type="Text" X="72" Y="42" Width="280" Height="22" Transparent="yes">
          <Text>Elegí la carpeta donde se va a instalar amover.</Text>
        </Control>
        <Control Id="FolderLabel" Type="Text" X="20" Y="90" Width="330" Height="15">
          <Text>Carpeta de destino:</Text>
        </Control>
        <Control Id="FolderEdit" Type="PathEdit" X="20" Y="105" Width="330" Height="18" Property="INSTALLDIR" Indirect="no" />
        <Control Id="InstallDirBack" Type="PushButton" X="168" Y="230" Width="56" Height="17" Text="&lt; Atrás">
          <Publish Event="NewDialog" Value="WelcomeDlg">1</Publish>
        </Control>
        <Control Id="InstallDirInstall" Type="PushButton" X="236" Y="230" Width="56" Height="17" Default="yes" Text="Instalar">
          <Publish Event="EndDialog" Value="Return" Order="1">1</Publish>
        </Control>
        <Control Id="InstallDirCancel" Type="PushButton" X="304" Y="230" Width="56" Height="17" Cancel="yes" Text="Cancelar">
          <Publish Event="EndDialog" Value="Exit">1</Publish>
        </Control>
      </Dialog>

      <!-- Instalación completada: mismo layout que la bienvenida, para
           simetría visual al abrir y cerrar el wizard. -->
      <Dialog Id="ExitDialog" Width="370" Height="260" Title="Instalación de amover">
        <Control Id="ExitBitmap" Type="Bitmap" X="0" Y="0" Width="130" Height="260" TabSkip="no" Text="LateralImageBmp" />
        <Control Id="ExitTitle" Type="Text" X="140" Y="20" Width="220" Height="40" Transparent="yes" NoPrefix="yes">
          <Text>{\AmoverTitle}Instalación completada</Text>
        </Control>
        <Control Id="ExitDescription" Type="Text" X="140" Y="65" Width="220" Height="140" Transparent="yes">
          <Text>amover se instaló correctamente en tu computadora.</Text>
        </Control>
        <Control Id="ExitFinish" Type="PushButton" X="304" Y="230" Width="56" Height="17" Default="yes" Cancel="yes" Text="Finalizar">
          <Publish Event="EndDialog" Value="Return">1</Publish>
        </Control>
      </Dialog>

      <InstallUISequence>
        <Show Dialog="WelcomeDlg" Before="ExecuteAction">NOT Installed</Show>
        <Show Dialog="ExitDialog" OnExit="success" />
      </InstallUISequence>
    </UI>

    <InstallExecuteSequence>
      <Custom Action="JpSetARPINSTALLLOCATION" After="CostFinalize">Not Installed</Custom>
      <Custom Action="JpSetARPCOMMENTS" After="CostFinalize">Not Installed</Custom>
      <Custom Action="JpSetARPCONTACT" After="CostFinalize">Not Installed</Custom>
      <Custom Action="JpSetARPSIZE" After="CostFinalize">Not Installed</Custom>
      <?ifdef JpHelpURL ?>
        <Custom Action="JpSetARPHELPLINK" After="CostFinalize">Not Installed</Custom>
      <?endif?>
      <?ifdef JpAboutURL ?>
        <Custom Action="JpSetARPURLINFOABOUT" After="CostFinalize">Not Installed</Custom>
      <?endif?>
      <?ifdef JpUpdateURL ?>
        <Custom Action="JpSetARPURLUPDATEINFO" After="CostFinalize">Not Installed</Custom>
      <?endif?>

      <?ifndef JpAllowUpgrades ?>
      <Custom Action="JpDisallowUpgrade" After="FindRelatedProducts">JP_UPGRADABLE_FOUND</Custom>
      <?endif?>
      <?ifndef JpAllowDowngrades ?>
      <Custom Action="JpDisallowDowngrade" After="FindRelatedProducts">JP_DOWNGRADABLE_FOUND</Custom>
      <?endif?>
      <RemoveExistingProducts Before="CostInitialize"/>
    </InstallExecuteSequence>

  </Product>
</Wix>
